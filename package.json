{
  "name": "resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && next dev --hostname 127.0.0.1",
    "dev:full": "node init && powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "build": "node init && next build",
    "lint": "eslint .",
    "start": "node init && next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:python": "python tests/test_ml_service.py",
    "golden:update": "node --experimental-strip-types scripts/generate-golden-latex.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:python && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "shadcn": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
